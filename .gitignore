#env
.env
.env.*

# Logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Design mockups and internal API docs — kept locally, not published.
# NOTE: these patterns must start at column 0. Leading whitespace is
# significant in .gitignore, so " New Ui/" (the previous value) only ever
# matched a directory literally named " New Ui" and never took effect.
/New Ui/
/docs/

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
